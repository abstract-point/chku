# Caddy reverse proxy for CHKU production
# Requires Caddy 2.11.4+ (Ubuntu 24.04 ships 2.6.2, which has known CVEs).
# Install from https://caddyserver.com/docs/install#debian-ubuntu-raspbian, then:
#   sudo cp infra/caddy/Caddyfile /etc/caddy/Caddyfile
#   sudo mkdir -p /var/log/caddy
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Replace YOUR_DOMAIN with the actual domain before copying.

{
    email admin@YOUR_DOMAIN
    servers {
        protocols h1 h2
    }
}

(security_headers) {
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }
}

www.YOUR_DOMAIN {
    redir https://YOUR_DOMAIN{uri} permanent
}

YOUR_DOMAIN {
    encode gzip
    import security_headers
    reverse_proxy 127.0.0.1:8080

    log {
        output file /var/log/caddy/YOUR_DOMAIN.access.log {
            roll_size 50MiB
            roll_keep 5
            roll_keep_for 720h
        }
        format console
    }
}
